# Public site settings. These are configuration values, not passwords.
SITE_URL=https://downsizebaltimore.com
# Use false for GoDaddy's private preview and true only for the live domain.
SITE_INDEXABLE=true

# Private publisher credentials. Generate the hash with:
# node scripts/hash-publisher-password.mjs
BLOG_LOGIN_USERNAME=replace-with-the-private-publisher-email
BLOG_LOGIN_PASSWORD_HASH=replace-with-the-generated-scrypt-hash

# Optional. Relative to the project root; GoDaddy preserves public/assets.
# APP_DATA_DIR=public/assets/.downsize-baltimore

# Constant Contact V3 server-side integration. Keep real credentials in GoDaddy's
# private environment settings, never in Git or browser code. Configure the
# OAuth app first, then connect it as a signed-in publisher at
# /api/admin/constant-contact/connect on the live domain.
# CC_CLIENT_ID=
# CC_CLIENT_SECRET=
# CC_REDIRECT_URI=https://downsizebaltimore.com/api/admin/constant-contact/callback
# CC_NEWSLETTER_LIST_ID=
# CC_CLUB_LIST_ID=
# CC_CLUB_TAG_ID=
# CC_SOURCE_FIELD_ID=
# CC_CLUB_ADDRESS_FIELD_ID=
# CC_CLUB_TIMING_FIELD_ID=
# CC_CLUB_PLANNING_FIELD_ID=
# CC_CLUB_TOWN_FIELD_ID=
# CC_CLUB_TIME_FIELD_ID=
